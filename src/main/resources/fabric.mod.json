{
	"schemaVersion": 1,
	"id": "mcdebug",
	"version": "${version}",
	"name": "mcdebug",
	"description": "Localhost JSON-RPC debug server for mod development automation. Exposes world/block-entity/inventory inspection and modification over TCP 127.0.0.1.",
	"authors": [
		"mcdebug"
	],
	"contact": {
		"homepage": "https://github.com/yu1745/mcdebug"
	},
	"license": "MIT",
	"environment": "server",
	"entrypoints": {
		"server": [
			{
				"adapter": "kotlin",
				"value": "com.mcdebug.McDebugMod"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.14.21",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
